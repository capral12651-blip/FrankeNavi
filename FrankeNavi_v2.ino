#include "Config.h"
#include "Navi.h"
#include "Android.h"
#include "Button.h"
#include "NTC.h"

// ============================================================
//  СОСТОЯНИЯ HVAC
// ============================================================

// Текущие состояния, полученные из callback
int currentFanSpeed  = 0;
int currentModeIndex = 0;
bool stateAC         = false;

// ============================================================
//  ТЕМПЕРАТУРЫ
// ============================================================

// Целевые температуры.
// Меняются энкодерами и используются для отправки в HiWorld.
int encPassTemp = DEFAULT_PASS_TEMP;
int encDrvTemp  = DEFAULT_DRV_TEMP;

// Фактические температуры,
// подтверждённые callback от климат-контроля.
int callbackPasTemp = DEFAULT_PASS_TEMP;
int callbackDrvTemp = DEFAULT_DRV_TEMP;

// ============================================================
//  SETUP
// ============================================================

void setup()
{
  
  Serial.begin(115200);

  Serial.println();
  Serial.println("========================================");
  Serial.println("        FrankeNavi starting...");
  Serial.println("========================================");

  // ----------------------------------------------------------
  //  ИНИЦИАЛИЗАЦИЯ МОДУЛЕЙ
  // ----------------------------------------------------------

  initNavi();
  initAndroid();
  initButtons();
  initEncoders();
  initNTC();

  
  
  // ----------------------------------------------------------
  //  ПЕРВИЧНОЕ СОСТОЯНИЕ HVAC
  // ----------------------------------------------------------

  // Даём Navi немного времени получить callback
  // с актуальным состоянием климат-контроля.
  unsigned long startTime = millis();
  
  while (waitingForCallback && millis() - startTime < 10000)
  {
    processNavi();
    delay(1);
  }

  // ----------------------------------------------------------
  //  СИНХРОНИЗАЦИЯ ЦЕЛЕВЫХ ТЕМПЕРАТУР
  // ----------------------------------------------------------

  encPassTemp = callbackPasTemp;
  encDrvTemp  = callbackDrvTemp;

  // ----------------------------------------------------------
  //  ПЕРВИЧНАЯ ОТПРАВКА В HiWorld
  // ----------------------------------------------------------

  sendHiWorld();

  Serial.println();
  Serial.println("[SYSTEM] FrankeNavi ready");
  Serial.print("[TEMP] Passenger: ");
  Serial.print(encPassTemp);
  Serial.print(" C | Driver: ");
  Serial.print(encDrvTemp);
  Serial.println(" C");
}

// ============================================================
//  LOOP
// ============================================================

void loop()
{
  // ----------------------------------------------------------
  //  NAVI / HVAC CALLBACK
  // ----------------------------------------------------------

  processNavi();

  // ----------------------------------------------------------
  //  ФИЗИЧЕСКИЕ КНОПКИ
  // ----------------------------------------------------------

  processButtons();

  // ----------------------------------------------------------
  //  ИНДИКАТОРЫ HVAC
  // ----------------------------------------------------------

  ind_State();

  // ----------------------------------------------------------
  //  ЭНКОДЕРЫ
  // ----------------------------------------------------------

  processEncoders();

  // ----------------------------------------------------------
  //  NTC
  // ----------------------------------------------------------

  processNTC();

  delay(1);
}